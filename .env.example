# Copy to .env (never commit it). Keys stay on the server and are never sent to the browser.

# --- Option A: OpenRouter (open-weight models such as DeepSeek) ---
OPENROUTER_API_KEY=
# Model id as listed on openrouter.ai/models. Default: deepseek/deepseek-chat
# OPENROUTER_MODEL=deepseek/deepseek-chat
# Data protection: by default only hosts that do NOT store or train on prompts are used.
# Set to "true" only if your firm policy allows it.
# OPENROUTER_ALLOW_DATA_COLLECTION=false
# Optionally pin which hosts may serve the model (comma-separated OpenRouter provider names), e.g. to keep data in an approved region.
# OPENROUTER_PROVIDERS=

# --- Option B: Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Force a provider: openrouter | anthropic | mock.
# Default: Anthropic if its key is set, else OpenRouter if its key is set, else the mock.
# LLM_PROVIDER=openrouter
